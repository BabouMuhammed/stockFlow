DATABASE_URL="postgresql://stockflow:stockflow_local@localhost:5432/stockflow?schema=public"
NODE_ENV=development
# Keep app locally. For a backend-first Render infrastructure check only, set
# DEPLOYMENT_MODE=bootstrap with NODE_ENV=production, omit WEB_ORIGIN,
# WEB_ORIGINS and TRUSTED_PROXY_CIDRS, and keep IMAGE_STORAGE=disabled.
# Bootstrap exposes health endpoints only; login and business APIs return 503.
DEPLOYMENT_MODE=app
PORT=5000
WEB_ORIGIN="http://localhost:5173"
# Exact CORS + CSRF allowlist; no wildcards. Overrides the default local pair.
WEB_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
# Keep browser cookies same-site through Vite's /api proxy to localhost:5000.
VITE_API_URL="/api/v1"
# Seed only a disposable local database; never customer data.
ALLOW_DEMO_SEED=false
# Optional: a separate empty PostgreSQL database for integration tests.
# TEST_DATABASE_URL="postgresql://stockflow:stockflow_local@localhost:5432/stockflow_test?schema=public"

# Deliberate, interactive, loopback-only first-owner setup. Disable afterwards.
ALLOW_OWNER_BOOTSTRAP=false
SESSION_HOURS=8

# Development defaults: trust no proxies and retain existing local images.
# Production requires explicit HTTPS WEB_ORIGIN (+ matching WEB_ORIGINS if set),
# and verified Render ingress IPs/CIDRs, never a wildcard, hop count, or /0.
TRUSTED_PROXY_CIDRS=""
# Leave unset in production to disable images until a durable store is configured.
# Production options: disabled, or persistent with an absolute UPLOAD_DIR.
# IMAGE_STORAGE=disabled
# UPLOAD_DIR="/var/data/stockflow/uploads"
# The mounted directory must contain .stockflow-storage with stockflow-persistent-v1.
