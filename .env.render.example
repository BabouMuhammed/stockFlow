# Render application mode: use only AFTER the proxy-mode code is published.
# Keep your existing DATABASE_URL secret in Render; do not copy the local URL.
# Set these entries together when leaving bootstrap mode.
NODE_ENV=production
DEPLOYMENT_MODE=app
WEB_ORIGIN=https://stock-flow-te4b-gamma.vercel.app
PROXY_MODE=none
SESSION_HOURS=8
IMAGE_STORAGE=disabled
NODE_VERSION=22
# Remove WEB_ORIGINS if it contains localhost or obsolete domains.
# Remove TRUSTED_PROXY_CIDRS and UPLOAD_DIR for this configuration.
# Render supplies PORT. Frontend VITE_API_URL remains /api/v1 on Vercel.
